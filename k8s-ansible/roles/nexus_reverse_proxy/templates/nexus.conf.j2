# Step 1: Map HTTP methods → correct Docker upstream
map $request_method $docker_upstream {
    default  http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_group_repo }}/;
    GET      http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_group_repo }}/;
    HEAD     http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_group_repo }}/;

    POST     http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_hosted_repo }}/;
    PUT      http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_hosted_repo }}/;
    PATCH    http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_hosted_repo }}/;
    DELETE   http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_hosted_repo }}/;
}

# HTTP → HTTPS
server {
    listen 80;
    server_name {{ registry_domain }};

    location /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

# HTTPS server
server {
    listen 443 ssl http2;
    server_name {{ registry_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ registry_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ registry_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 5G;

    # Nexus UI
    location / {
        proxy_pass http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Docker registry redirects
    location = /v2 { return 301 /v2/; }

    location /v2/ {
        proxy_pass $docker_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_request_buffering off;
        proxy_buffering off;
        chunked_transfer_encoding off;
    }
}
