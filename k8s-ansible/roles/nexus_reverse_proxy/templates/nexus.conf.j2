{# NGINX sits in front of Nexus and decides:
Who goes where
Who must use HTTPS
How big uploads can be
How Docker traffic is handled #}

# Nexus + Docker Registry (single-domain)

# Step 1: Map HTTP methods → correct Docker upstream
map $request_method $docker_upstream {
    default  http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_group_repo }}/;
    GET      http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_group_repo }}/;
    HEAD     http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_group_repo }}/;

    POST     http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_hosted_repo }}/;
    PUT      http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_hosted_repo }}/;
    PATCH    http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_hosted_repo }}/;
    DELETE   http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_hosted_repo }}/;
}

# -------------------------------------------------------
# Step 2: HTTP server → Certbot + redirect to HTTPS
# -------------------------------------------------------
server {
    listen 80;
    server_name {{ registry_domain }};

    # Certbot validation challenge
    location /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
    }

    # Redirect all other HTTP traffic to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# -------------------------------------------------------
# Step 3: HTTPS server
# -------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name {{ registry_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ registry_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ registry_domain }}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 5G;

    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header X-XSS-Protection "1; mode=block";

    # Nexus UI
    location / {
        proxy_pass http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Docker registry
    location = /v2 {
        return 301 /v2/;
    }

    location /v2/ {
        proxy_pass http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_group_repo }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_request_buffering off;
        proxy_buffering off;
        chunked_transfer_encoding off;
    }
}
