# =========================
# Nexus Docker Registry Nginx Config
# Fully reusable with variables:
#   {{ nexus_upstream_host }}, {{ nexus_upstream_port }}
#   {{ docker_group_repo }}, {{ docker_hosted_repo }}
#   {{ registry_domain }}
# =========================

# Step 1: Map HTTP methods → Docker upstreams
map $request_method $docker_upstream {
    default  http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_group_repo }}/v2/;
    GET      http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_group_repo }}/v2/;
    HEAD     http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_group_repo }}/v2/;

    POST     http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_hosted_repo }}/v2/;
    PUT      http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_hosted_repo }}/v2/;
    PATCH    http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_hosted_repo }}/v2/;
    DELETE   http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/repository/{{ docker_hosted_repo }}/v2/;
}

# Step 2: HTTP → HTTPS redirect
server {
    listen 80;
    server_name {{ registry_domain }};

    location /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

# Step 3: HTTPS server
server {
    listen 443 ssl http2;
    server_name {{ registry_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ registry_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ registry_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 5G;

    # ===== Nexus UI (normal web access) =====
    location / {
        proxy_pass http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ===== Docker registry redirects =====
    location = /v2 { return 301 /v2/; }

    location /v2/ {
        proxy_pass $docker_upstream;

        # Required headers for Docker
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Docker push/pull tweaks
        proxy_request_buffering off;
        proxy_buffering off;
        chunked_transfer_encoding on;
    }
}
