# NGINX config – path-based single-domain Docker with Nexus
# - Requests to /v2/myapp-docker-hosted/... → proxy to hosted repo
# - All other /v2/... → proxy to group repo (for pulls)
# No rewrites → no "Not a docker request" or URI errors

map $request_uri $docker_repo_path {
    ~^/v2/{{ docker_hosted_repo }}(/.*)?$   /repository/{{ docker_hosted_repo }}$1;
    default                                  /repository/{{ docker_group_repo }}$1;
}

server {
    listen 80;
    server_name {{ registry_domain }};

    location /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        try_files $uri $uri/ =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name {{ registry_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ registry_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ registry_domain }}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header X-XSS-Protection "1; mode=block" always;

    client_max_body_size 10G;

    location / {
        proxy_pass http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_redirect off;
    }

    location = /v2 {
        return 301 /v2/;
    }

    location /v2/ {
        proxy_pass http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}$docker_repo_path;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Connection "";

        proxy_request_buffering off;
        proxy_buffering off;
        chunked_transfer_encoding on;

        proxy_read_timeout 600;
        proxy_connect_timeout 600;
        proxy_send_timeout 600;
    }
}



{# # NGINX config template – fixed for "cannot have URI part" error
# Proxy server separate, Nexus at {{ nexus_upstream_host }}:{{ nexus_upstream_port }}

map $request_method $nexus_base {
    default http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }};
}

server {
    listen 80;
    server_name {{ registry_domain }};

    location /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        try_files $uri $uri/ =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name {{ registry_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ registry_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ registry_domain }}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header X-XSS-Protection "1; mode=block" always;

    client_max_body_size 10G;

    # Nexus UI / main paths
    location / {
        proxy_pass http://{{ nexus_upstream_host }}:{{ nexus_upstream_port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_redirect off;
    }

    location = /v2 {
        return 301 /v2/;
    }

    location /v2/ {
        proxy_pass $nexus_base;

        # Rewrite ONLY for push methods to hosted repo
        if ($request_method ~ ^(POST|PUT|PATCH|DELETE)$) {
            rewrite ^/v2/(.*)$ /repository/{{ docker_hosted_repo }}/$1 break;
        }

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Connection "";

        proxy_request_buffering off;
        proxy_buffering off;
        chunked_transfer_encoding on;

        proxy_read_timeout 600;
        proxy_connect_timeout 600;
        proxy_send_timeout 600;
    }

    # Optional debug endpoints (no rewrite)
    location ~ ^/v2/(_catalog|_ping|token.*)$ {
        proxy_pass $nexus_base;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
    }
} #}