import jenkins.model.*
import com.cloudbees.plugins.credentials.*
import com.cloudbees.plugins.credentials.domains.*
import com.cloudbees.plugins.credentials.impl.*
import hudson.util.Secret           // ← important for wrapping passwords

def instance = Jenkins.get()
def provider = instance.getExtensionList(SystemCredentialsProvider)[0]
def store    = provider.getStore()
def domain   = Domain.global()

// Helper that also forces persistence
def createOrUpdate(String id, String description, String username, String password) {
    def existing = store.getCredentials(domain).find { it.id == id }

    def cred = new UsernamePasswordCredentialsImpl(
        id,                             // id
        description,
        username,
        Secret.fromString(password)     // ← Secret is strongly recommended
    )

    // Scope is usually GLOBAL for system-wide credentials
    // (you had it correct, but many people accidentally remove it or set to null)
    // cred.setScope(CredentialsScope.GLOBAL)   // optional - constructor already uses GLOBAL by default

    if (existing != null) {
        println "Updating credential: ${id}"
        def r = store.updateCredentials(domain, existing, cred)
        if (!r) {
            println "!!! Update failed for ${id}"
        }
    } else {
        println "Creating credential: ${id}"
        def r = store.addCredentials(domain, cred)
        if (!r) {
            println "!!! Add failed for ${id}"
        }
    }
}

// ────────────────────────────────────────────────
//  !!! Almost certainly the main problem !!!
//
// If you see the literal "{{ vault_nexus_user_username }}" printed
// or in the credential username field → Jinja2 / ansible templating
// did NOT run on this file.
//
// You must template this file **before** executing it.
//
createOrUpdate(
    "nexus-creds",
    "Nexus API / Maven credential",
    "{{ vault_nexus_user_username }}",
    "{{ vault_nexus_user_password }}"
)

createOrUpdate(
    "docker-registry-creds",
    "Docker Registry credential",
    "{{ vault_nexus_user_username }}",     // ← same user/pass as nexus?
    "{{ vault_nexus_user_password }}"
)

createOrUpdate(
    "github-creds",
    "GitHub PAT credential",
    "{{ vault_github_username }}",
    "{{ vault_github_pat }}"
)

// Important in some versions/contexts (init.groovy.d, JCasC, docker startup)
store.persist()
provider.save()
instance.save()

println "Script finished. Check Manage Jenkins → Credentials → System → Global credentials"