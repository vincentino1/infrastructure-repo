content: |
          events { worker_connections 1024; }

          http {
            proxy_send_timeout 300;
            proxy_read_timeout 300;
            proxy_buffering off;
            keepalive_timeout 5 5;
            tcp_nodelay on;
            client_max_body_size 0;

            server {
              listen 443 ssl;
              server_name {{ registry_domain }};

              ssl_certificate /etc/nginx/certs/nexus.crt;
              ssl_certificate_key /etc/nginx/certs/nexus.key;

              location /v2/{{docker_hosted_repo}}/ {
                proxy_pass http://{{ nexus_private_ip }}:8081/repository/{{docker_hosted_repo}}/;
              
                proxy_set_header Host $host;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto https;
                proxy_buffering off;
              
              }

              location /v2/{{docker_group_repo}}/ { 
                proxy_pass http://{{ nexus_private_ip }}:8081/repository/{{docker_group_repo}}/; 
                proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; 
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; 
                proxy_set_header X-Forwarded-Proto https; 
                proxy_buffering off;
              }

              location / {
                proxy_pass http://{{ nexus_private_ip }}:8081/;
                proxy_set_header Host $host;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto "https";
              }
            }

            server {
              listen 80;
              server_name {{ registry_domain }};
              return 301 https://$host$request_uri;
            }
          }